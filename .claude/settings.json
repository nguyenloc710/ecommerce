{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(.\\mvnw.cmd *)",
      "Bash(mvnw.cmd *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx prettier *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(helm template *)",
      "Bash(helm lint *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl get *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(kubectl apply *)",
      "Bash(helm upgrade *)",
      "Bash(helm install *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-migrations.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
